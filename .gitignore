# ============================================================
# BUILD OUTPUT DIRECTORIES
# ============================================================
build-*/
cmake-build-*/
app/build/

# ============================================================
# COMPILED BINARIES & LIBRARIES
# ============================================================
*.so
*.o
*.obj
*.a
*.lib
*.dll
*.dylib

# ============================================================
# TEXT AND MARKDOWN FILES
# (Ignore all .txt and .md files except README.md)
# ============================================================
*.txt
*.md
!README.md
!AGENTS.md
!**/README.md
!app/analysis_options.yaml

# ============================================================
# LOGS & TEMPORARY FILES
# ============================================================
*.log

# Video-agent plugin scratch
.video_agent/

# ============================================================
# LARGE MODEL FILES
# ============================================================
# GGUF quantised models
*.gguf

# Safetensors / binary model weights
*.safetensors
*.bin

# ============================================================
# LORA / FINE-TUNING ARTIFACTS
# (training outputs — not part of the runnable app)
# ============================================================
lora_bnb/
lora_fp16/
lora_full/
lora_new/

# ============================================================
# TEST MODEL DIRECTORY
# (ignore directory content except gemma-3 models)
# ============================================================
test_model/*

# ============================================================
# PYTHON TRAINING / CONVERSION SCRIPTS & CACHE
# (not part of the Flutter app)
# ============================================================
extract_lora.py
run_lora.py
lora_examples/
__pycache__/
*.pyc
*.pyo

# ============================================================
# LLAMA.CPP UPSTREAM SOURCE
# (tracked as a git submodule — do NOT ignore here)
# ============================================================
# llama.cpp/ is registered as a submodule in .gitmodules

# ============================================================
# FLUTTER / DART GENERATED FILES
# ============================================================
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.pub-cache/
app/.pub/

# ============================================================
# ANDROID LOCAL FILES
# ============================================================
app/android/local.properties
app/android/.gradle/
app/android/.kotlin/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/

# ============================================================
# IDE & EDITOR FILES
# ============================================================
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db

# ============================================================
# UI PROTOTYPE (HTML/CSS sketch, not Flutter source)
# ============================================================
ui_prototype/


# Local llama.cpp CLI binaries (downloaded release zips)
llama-bin/

# Training venv and outputs
training/.venv/
training/out*/
training/ckpt/

# Local HF model checkouts for training (weights already ignored; configs and
# tokenizer are re-downloadable from the hub, don't track copies)
training/models/

# Bake-off eval outputs (JSONL runs, logs)
training/eval_out/

# Local MNN tree: upstream source, arm64 builds, converted models, bench
# scripts and phone artifacts (~5GB). Local-only working material.
mnn/

# Pig-farm art pipeline (sketches, renders, generated breed PNGs) —
# sprites enter the app via app/assets/, the working dir stays local.
pigs/

# Tool hook state
.mimosa/
